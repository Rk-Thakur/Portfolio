# Copy to .env.local (never commit .env.local) and fill in from
# Supabase → Project Settings → API (or "API Keys").

# Public: safe in the browser. RLS rules protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET: server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit.
# Not needed until the admin stage; leave empty for now.
SUPABASE_SERVICE_ROLE_KEY=
